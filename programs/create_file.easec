note Create a text file from interactive input.

job read_until(terminator) {
    var content = ""
    repeat forever {
        var line = input()
        if line == null or line == terminator { out content }
        content += line + "\n"
    }
}

say "Enter target filename:"
var filename = input()

say "Enter content (type 'create_file.exit' on its own line to save):"
var content = read_until("create_file.exit")

if file.create(filename, content) {
    say "File created successfully."
} else {
    say "Could not create file (invalid name or no space)."
}
