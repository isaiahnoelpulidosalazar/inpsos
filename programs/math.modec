note Math helpers. Import with:  import "math.modec" as m
var PI: decimal = 3.14159
var E: decimal = 2.71828

job add(a, b) { out a + b }
job multiply(a, b) { out a * b }

job factorial(n) {
    if n <= 1 { out 1 }
    out n * factorial(n - 1)
}

job fibonacci(n) {
    if n <= 1 { out n }
    out fibonacci(n - 1) + fibonacci(n - 2)
}
