import "datetime.modec" as dt

say "--- easec datetime demo ---"
say "Today's date (UTC):  " + dt.today()
say "Current time (UTC):  " + dt.now_time()
say "Full ISO timestamp:  " + dt.now_iso()
say ""

say "Sleeping for 1.5 seconds..."
var t1 = time.uptime()
time.sleep(1500)
var t2 = time.uptime()
say "Elapsed time (ms): " + (t2 - t1)
