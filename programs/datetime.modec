note easec datetime module (UTC). Import with:  import "datetime.modec" as dt
note All functions take epoch MILLISECONDS (what time.now() returns).

var DAYS_IN_MONTH = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

job is_leap(year) {
    out (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
}

note Pad a number with a leading zero: 7 -> "07"
job pad(n) {
    if n < 10 { out "0" + n }
    out "" + n
}

note Break epoch milliseconds into a dictionary of UTC components.
note (Replaces the original 12-level nested if/else ladder with a table lookup.)
job get_utc_dict(epoch_ms) {
    var total_seconds = epoch_ms / 1000
    var total_minutes = total_seconds / 60
    var total_hours = total_minutes / 60
    var days = total_hours / 24

    var year = 1970
    repeat forever {
        var days_in_year = 365
        if is_leap(year) { days_in_year = 366 }
        if days < days_in_year { stop }
        days -= days_in_year
        year += 1
    }

    var month = 0
    repeat forever {
        var dim = DAYS_IN_MONTH[month]
        if month == 1 and is_leap(year) { dim = 29 }
        if days < dim { stop }
        days -= dim
        month += 1
    }

    out {
        year: year, month: month + 1, day: days + 1,
        hour: total_hours % 24, minute: total_minutes % 60, second: total_seconds % 60
    }
}

job date_string(epoch_ms) {
    var d = get_utc_dict(epoch_ms)
    out d.year + "-" + pad(d.month) + "-" + pad(d.day)
}

job time_string(epoch_ms) {
    var d = get_utc_dict(epoch_ms)
    out pad(d.hour) + ":" + pad(d.minute) + ":" + pad(d.second)
}

job iso_string(epoch_ms) { out date_string(epoch_ms) + " " + time_string(epoch_ms) }

job today() { out date_string(time.now()) }
job now_time() { out time_string(time.now()) }
job now_iso() { out iso_string(time.now()) }
